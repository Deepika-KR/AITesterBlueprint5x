{
  "name": "vwo-playwright-framework",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript Playwright framework for verified VWO login-page behavior",
  "scripts": {
    "test": "playwright test",
    "test:valid": "playwright test tests/login-valid.spec.ts",
    "test:invalid": "playwright test tests/login-invalid.spec.ts",
    "test:headed": "playwright test --headed --project=chromium",
    "test:debug": "playwright test --debug --project=chromium",
    "typecheck": "tsc --noEmit",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  }
}
